{
  "name": "consumo-meta",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "tsx watch --import ./backend/server/instrumentation.ts backend/server/index.ts",
    "dev:client": "npm run dev -w frontend",
    "dev:full": "concurrently -n api,web -c blue,green \"npm run dev\" \"npm run dev:client\"",
    "build:client": "npm run build -w frontend",
    "start": "tsx --import ./backend/server/instrumentation.ts backend/server/index.ts",
    "lint": "tsc -p backend --noEmit && tsc -p frontend --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "prisma": "prisma"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.0",
    "jsdom": "^27.0.0",
    "prisma": "^7.10.1",
    "typescript": "~5.8.3",
    "vite": "~6.4.0",
    "vitest": "^5.1.0"
  }
}
