# Servidor
PORT=3002
NODE_ENV=development
# Banco (o compose sobrescreve DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=consumo
DB_PASSWORD=consumo
DB_NAME=consumo_meta
DATABASE_URL=postgresql://consumo:consumo@localhost:5432/consumo_meta
# Helena/Chatfast (valida o agente e quem é admin)
HELENA_API_URL=https://api.helena.run
# Embed e sessão: vazios = ligados só em produção. Em dev, a sessão é de admin sem Helena.
EXIGIR_EMBED=
EXIGIR_SESSAO=
ORIGENS_EMBED=https://app.chatfast.chat https://web.helena.run
# Sessão: mínimo 32 caracteres
SEGREDO_SESSAO=troque-por-um-segredo-com-32-caracteres-ou-mais
# companyid(s) da Fasterisk, separados por vírgula
ADMIN_COMPANYIDS=
# 32 bytes em base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTOGRAFIA=
# Meta
META_GRAPH_VERSION=v27.0
# Coleta
SYNC_CRON=0 * * * *
SYNC_DIAS_REPROCESSO=3
SYNC_DIAS_BACKFILL=90
# Cotação USD→BRL automática pela PTAX do Banco Central (API pública). Vazio/true = ligada; false = só manual.
COTACAO_AUTOMATICA=
# Alertas de consumo (opcional): webhook do n8n que recebe um POST quando um cliente passa do
# limite diário ou mensal em R$ (definidos no /admin). Vazio = alertas desligados.
N8N_WEBHOOK_ALERTAS=
# Monitor externo (opcional): recebe GET a cada tick, /fail se o tick quebrar
HEARTBEAT_URL=
# OpenTelemetry (opcional: só liga com o endpoint)
OTEL_SERVICE_NAME=consumo-meta
OTEL_EXPORTER_OTLP_ENDPOINT=
