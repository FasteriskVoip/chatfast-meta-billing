{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": { "@/*": ["frontend/src/*"] }
  },
  "include": ["backend/tests/**/*.ts", "frontend/src/**/*.spec.tsx", "frontend/src/**/*.spec.ts", "vitest.config.ts", "vitest.setup.ts"]
}
